{
    "Comment": "Order processing workflow used to demo the sfn-diagram PR preview action",
    "StartAt": "ValidateOrder",
    "States": {
        "ValidateOrder": {
            "Type": "Pass",
            "Next": "CheckStock"
        },
        "CheckStock": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.inStock",
                    "BooleanEquals": true,
                    "Next": "ChargePayment"
                }
            ],
            "Default": "OrderComplete"
        },
        "ChargePayment": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:us-east-1:123456789012:function:charge-payment-v2",
            "Next": "FraudCheck"
        },
        "FraudCheck": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:us-east-1:123456789012:function:fraud-check",
            "Next": "ShipOrder"
        },
        "ShipOrder": {
            "Type": "Task",
            "Resource": "arn:aws:lambda:us-east-1:123456789012:function:ship-order",
            "Next": "OrderComplete"
        },
        "OrderComplete": {
            "Type": "Succeed"
        }
    }
}
