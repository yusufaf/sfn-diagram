{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "80799ec3893b390c95d86dbf2032e21c9282e3af",
  "packages": {
    ".": {
      "release-type": "node",
      "extra-files": [
        { "type": "json", "path": "jsr.json", "jsonpath": "$.version" },
        { "type": "generic", "path": "site/src/content/docs/guides/other-languages.md" }
      ],
      "exclude-paths": [
        "packages/github-action-sfn-diagram",
        "packages/sfn-diagram-react",
        "packages/vscode-sfn-diagram"
      ]
    },
    "packages/github-action-sfn-diagram": {
      "component": "github-action-sfn-diagram",
      "release-type": "node",
      "versioning": "always-bump-minor"
    },
    "packages/sfn-diagram-react": {
      "component": "sfn-diagram-react",
      "release-type": "node"
    },
    "packages/vscode-sfn-diagram": {
      "component": "vscode-sfn-diagram",
      "release-type": "node"
    }
  }
}
