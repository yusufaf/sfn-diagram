{
  "Comment": "Test state machine demonstrating various AWS service integrations",
  "StartAt": "InvokeLambda",
  "States": {
    "InvokeLambda": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:ProcessData",
      "Comment": "Lambda function invocation",
      "Next": "PutItemDynamoDB"
    },
    "PutItemDynamoDB": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "MyTable",
        "Item": {
          "id": {
            "S.$": "$.id"
          }
        }
      },
      "Comment": "DynamoDB PutItem",
      "Next": "SendSQSMessage"
    },
    "SendSQSMessage": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage",
      "Parameters": {
        "QueueUrl": "https://sqs.us-east-1.amazonaws.com/123456789012/MyQueue",
        "MessageBody.$": "$.message"
      },
      "Comment": "Send SQS message",
      "Next": "PutS3Object"
    },
    "PutS3Object": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
      "Parameters": {
        "Bucket": "my-bucket",
        "Key.$": "$.filename",
        "Body.$": "$.content"
      },
      "Comment": "Upload to S3",
      "Next": "PublishSNS"
    },
    "PublishSNS": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:us-east-1:123456789012:MyTopic",
        "Message.$": "$.notification"
      },
      "Comment": "Publish SNS notification",
      "Next": "RunECSTask"
    },
    "RunECSTask": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "Cluster": "my-cluster",
        "TaskDefinition": "my-task"
      },
      "Comment": "Run ECS task",
      "Next": "StartGlueJob"
    },
    "StartGlueJob": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "my-etl-job"
      },
      "Comment": "Start Glue ETL job",
      "Next": "InvokeSageMaker"
    },
    "InvokeSageMaker": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sagemaker:createTrainingJob.sync",
      "Parameters": {
        "TrainingJobName": "my-training-job",
        "AlgorithmSpecification": {
          "TrainingImage": "image-uri",
          "TrainingInputMode": "File"
        }
      },
      "Comment": "SageMaker training job",
      "Next": "CheckChoice"
    },
    "CheckChoice": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.status",
          "StringEquals": "success",
          "Next": "Success"
        },
        {
          "Variable": "$.status",
          "StringEquals": "error",
          "Next": "HandleError"
        }
      ],
      "Default": "Success"
    },
    "HandleError": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:cloudwatch:putMetricData",
      "Parameters": {
        "Namespace": "MyApp",
        "MetricData": [
          {
            "MetricName": "Errors",
            "Value": 1
          }
        ]
      },
      "Comment": "Log error to CloudWatch",
      "Next": "Fail"
    },
    "Success": {
      "Type": "Succeed",
      "Comment": "Workflow completed successfully"
    },
    "Fail": {
      "Type": "Fail",
      "Comment": "Workflow failed"
    }
  }
}
