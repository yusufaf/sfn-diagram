{
    "Comment": "Distributed Map using ItemProcessor (modern syntax)",
    "StartAt": "SplitInput",
    "States": {
        "SplitInput": {
            "Type": "Pass",
            "Next": "ProcessItems"
        },
        "ProcessItems": {
            "Type": "Map",
            "ItemsPath": "$.items",
            "MaxConcurrency": 100,
            "ToleratedFailurePercentage": 5,
            "Label": "OrderBatch",
            "ItemReader": {
                "Resource": "arn:aws:states:::s3:getObject",
                "ReaderConfig": {
                    "InputType": "CSV",
                    "MaxItems": 10000
                },
                "Parameters": {
                    "Bucket": "orders-input",
                    "Key": "batch.csv"
                }
            },
            "ItemBatcher": {
                "MaxItemsPerBatch": 50
            },
            "ResultWriter": {
                "Resource": "arn:aws:states:::s3:putObject",
                "Parameters": {
                    "Bucket": "orders-output",
                    "Prefix": "results"
                }
            },
            "ItemProcessor": {
                "ProcessorConfig": {
                    "Mode": "DISTRIBUTED",
                    "ExecutionType": "STANDARD"
                },
                "StartAt": "ProcessItem",
                "States": {
                    "ProcessItem": {
                        "Type": "Task",
                        "Resource": "arn:aws:lambda:us-east-1:123456789012:function:ProcessItem",
                        "Next": "ValidateItem"
                    },
                    "ValidateItem": {
                        "Type": "Pass",
                        "End": true
                    }
                }
            },
            "Next": "Done"
        },
        "Done": {
            "Type": "Succeed"
        }
    }
}
