{
  "Comment": "State machine with error handling",
  "StartAt": "RiskyTask",
  "States": {
    "RiskyTask": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:RiskyTask",
      "Catch": [
        {
          "ErrorEquals": ["States.TaskFailed"],
          "Next": "HandleError"
        },
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "FallbackError"
        }
      ],
      "Next": "Success"
    },
    "HandleError": {
      "Type": "Pass",
      "Result": "Handled specific error",
      "Next": "Success"
    },
    "FallbackError": {
      "Type": "Pass",
      "Result": "Handled fallback error",
      "Next": "Success"
    },
    "Success": {
      "Type": "Succeed"
    }
  }
}
