{
  "Comment": "Simple linear state machine",
  "StartAt": "Start",
  "States": {
    "Start": {
      "Type": "Pass",
      "Comment": "Starting state",
      "Next": "Process"
    },
    "Process": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:123456789012:function:ProcessTask",
      "Next": "End"
    },
    "End": {
      "Type": "Succeed"
    }
  }
}
