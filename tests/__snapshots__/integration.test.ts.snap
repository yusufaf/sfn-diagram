    classDef mapState fill:#f1f8e9,stroke:#558b2f,stroke-width:2px

    class ProcessIncomingCustomerOrderAndNotifyDownstreamSystems taskState
    class ValidateOrder taskState
    class IsOrderAcceptableForImmediateFulfillment choiceState
