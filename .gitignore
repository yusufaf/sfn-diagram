node_modules
dist
packages/*/out
# Turborepo local cache / logs
.turbo
**/.turbo
# Coverage output
coverage
# Action bundle must be committed so `uses: ./packages/github-action-sfn-diagram` works
!packages/github-action-sfn-diagram/dist
# ...but its manifest must NOT be committed as action.yml, or GitHub treats this
# monorepo as the canonical action and suppresses the Marketplace mirror. The
# source of truth is action.template.yml; action.yml is rendered at run time.
packages/github-action-sfn-diagram/action.yml
*.log
.DS_Store
.env
.vscode
!packages/*/.vscode

# Generated type declarations (keep only custom module declarations)
src/**/*.d.ts
!src/dagre.d.ts

# Examples output directory (generated files)
examples/outputs/

# AI planning docs (local only)
docs/superpowers/

# Packaged VS Code extension artifacts
*.vsix
