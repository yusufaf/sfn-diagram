{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@yusufaf/sfn-diagram",
  "version": "1.0.0",
  "exports": {
    ".": "./src/index.ts",
    "./png": "./src/png.ts",
    "./aws": "./src/aws.ts",
    "./cfn": "./src/cfn.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "LICENSE",
      "jsr.json"
    ],
    "exclude": [
      "src/**/*.test.ts",
      "dist",
      "tests"
    ]
  }
}
