{
  "name": "sfn-diagram",
  "version": "0.2.0",
  "description": "Generate SVG diagrams from AWS Step Functions ASL definitions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "examples": "vitest run tests/visual-outputs.test.ts",
    "lint": "eslint .",
    "prepublishOnly": "pnpm run build && pnpm run validate",
    "release": "npm publish",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run validate:publint && pnpm run validate:types",
    "validate:publint": "publint",
    "validate:types": "attw --pack ."
  },
  "keywords": [
    "aws",
    "step-functions",
    "diagram",
    "visualization",
    "svg",
    "asl",
    "state-machine"
  ],
  "author": "Yusuf Afzal",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@aws-sdk/client-sfn": "^3.879.0",
    "@eslint/js": "^9.34.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "publint": "^0.3.16",
    "tsdown": "^0.21.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.0",
    "@types/jsdom": "^27.0.0",
    "d3": "^7.8.5",
    "jsdom": "^27.2.0",
    "node-html-to-image": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": ">=5.3.0",
      "brace-expansion": ">=2.0.3",
      "defu": ">=6.1.5",
      "dompurify": ">=3.4.0",
      "fast-xml-parser": ">=5.5.7",
      "flatted": ">=3.4.2",
      "handlebars": ">=4.7.9",
      "lodash-es": ">=4.18.0",
      "minimatch": ">=9.0.7",
      "picomatch": ">=4.0.4",
      "rollup": ">=4.59.0",
      "vite": ">=7.3.2"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufaf/sfn-diagram.git"
  },
  "bugs": {
    "url": "https://github.com/yusufaf/sfn-diagram/issues"
  },
  "homepage": "https://github.com/yusufaf/sfn-diagram#readme"
}
