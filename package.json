{
  "name": "sfn-diagram",
  "version": "0.7.0",
  "description": "Generate SVG diagrams from AWS Step Functions ASL definitions",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./png": {
      "import": {
        "types": "./dist/png.d.ts",
        "default": "./dist/png.js"
      },
      "require": {
        "types": "./dist/png.d.cts",
        "default": "./dist/png.cjs"
      }
    },
    "./aws": {
      "import": {
        "types": "./dist/aws.d.ts",
        "default": "./dist/aws.js"
      },
      "require": {
        "types": "./dist/aws.d.cts",
        "default": "./dist/aws.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "png": [
        "./dist/png.d.ts"
      ],
      "aws": [
        "./dist/aws.d.ts"
      ]
    }
  },
  "bin": {
    "sfn-diagram": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "examples": "vitest run tests/visual-outputs.test.ts",
    "lint": "eslint .",
    "lint:ox": "oxlint",
    "prepublishOnly": "pnpm run build && pnpm run validate",
    "release": "npm publish",
    "sync:action": "bash scripts/sync-action-mirror.sh",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run validate:publint && pnpm run validate:types",
    "validate:publint": "publint",
    "validate:types": "attw --pack .",
    "prepare": "husky"
  },
  "keywords": [
    "aws",
    "step-functions",
    "diagram",
    "visualization",
    "svg",
    "asl",
    "state-machine"
  ],
  "author": "Yusuf Afzal",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@aws-sdk/client-sfn": "^3.879.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.34.0",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "node-html-to-image": "^5.0.0",
    "oxlint": "^1.69.0",
    "prettier": "3.6.2",
    "publint": "^0.3.16",
    "puppeteer": "23.2.2",
    "tsdown": "^0.21.7",
    "tsx": "^4.20.5",
    "turbo": "^2.10.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.0",
    "d3-shape": "^3.2.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-sfn": "^3.0.0",
    "node-html-to-image": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sfn": {
      "optional": true
    },
    "node-html-to-image": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": ">=5.3.1",
      "brace-expansion": ">=2.0.3",
      "defu": ">=6.1.5",
      "dompurify": ">=3.4.0",
      "esbuild": ">=0.28.1",
      "fast-xml-builder": ">=1.1.7",
      "fast-xml-parser": ">=5.7.0",
      "flatted": ">=3.4.2",
      "handlebars": ">=4.7.9",
      "ip-address": ">=10.1.1",
      "js-yaml": ">=4.2.0 <5.0.0",
      "lodash-es": ">=4.18.0",
      "minimatch": ">=9.0.7",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.10",
      "rollup": ">=4.59.0",
      "undici": ">=6.27.0",
      "vite": ">=8.0.16",
      "ws": ">=8.20.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufaf/sfn-diagram.git"
  },
  "bugs": {
    "url": "https://github.com/yusufaf/sfn-diagram/issues"
  },
  "homepage": "https://github.com/yusufaf/sfn-diagram#readme"
}
