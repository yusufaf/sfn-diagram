{
  "name": "sfn-diagram",
  "version": "0.1.0",
  "description": "Generate SVG diagrams from AWS Step Functions ASL definitions",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index-BQQPw8Ms.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index-BQQPw8Ms.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index-C-h6y7Iz.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "examples": "vitest run tests/visual-outputs.test.ts",
    "release": "npm publish",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "aws",
    "step-functions",
    "diagram",
    "visualization",
    "svg",
    "asl",
    "state-machine"
  ],
  "author": "Yusuf Afzal",
  "license": "MIT",
  "devDependencies": {
    "@aws-sdk/client-sfn": "^3.879.0",
    "@eslint/js": "^9.34.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "tsdown": "^0.14.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.0",
    "@types/jsdom": "^27.0.0",
    "d3": "^7.8.5",
    "jsdom": "^27.2.0",
    "mermaid": "^11.12.1",
    "node-html-to-image": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yusufaf/sfn-diagram.git"
  },
  "bugs": {
    "url": "https://github.com/yusufaf/sfn-diagram/issues"
  },
  "homepage": "https://github.com/yusufaf/sfn-diagram#readme"
}
