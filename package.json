{
  "name": "sfn-diagram",
  "version": "1.5.1",
  "description": "Generate SVG, Mermaid, HTML, and PNG diagrams from AWS Step Functions ASL definitions, CloudFormation/CDK templates, or live AWS state machines",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "sideEffects": [
    "./dist/element.js",
    "./dist/element.cjs",
    "./dist/element-auto.js",
    "./dist/element-auto.cjs"
  ],
  "customElements": "custom-elements.json",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./png": {
      "import": {
        "types": "./dist/png.d.ts",
        "default": "./dist/png.js"
      },
      "require": {
        "types": "./dist/png.d.cts",
        "default": "./dist/png.cjs"
      }
    },
    "./aws": {
      "import": {
        "types": "./dist/aws.d.ts",
        "default": "./dist/aws.js"
      },
      "require": {
        "types": "./dist/aws.d.cts",
        "default": "./dist/aws.cjs"
      }
    },
    "./cfn": {
      "import": {
        "types": "./dist/cfn.d.ts",
        "default": "./dist/cfn.js"
      },
      "require": {
        "types": "./dist/cfn.d.cts",
        "default": "./dist/cfn.cjs"
      }
    },
    "./ci": {
      "import": {
        "types": "./dist/ci.d.ts",
        "default": "./dist/ci.js"
      },
      "require": {
        "types": "./dist/ci.d.cts",
        "default": "./dist/ci.cjs"
      }
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "require": {
        "types": "./dist/element.d.cts",
        "default": "./dist/element.cjs"
      }
    },
    "./element/auto": {
      "import": {
        "types": "./dist/element-auto.d.ts",
        "default": "./dist/element-auto.js"
      },
      "require": {
        "types": "./dist/element-auto.d.cts",
        "default": "./dist/element-auto.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "png": [
        "./dist/png.d.ts"
      ],
      "aws": [
        "./dist/aws.d.ts"
      ],
      "cfn": [
        "./dist/cfn.d.ts"
      ],
      "ci": [
        "./dist/ci.d.ts"
      ],
      "element": [
        "./dist/element.d.ts"
      ],
      "element/auto": [
        "./dist/element-auto.d.ts"
      ]
    }
  },
  "bin": {
    "sfn-diagram": "dist/cli.js"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run build:viewer-script && pnpm run build:manifest && tsdown",
    "build:action-bundle": "tsdown && pnpm --filter github-action-sfn-diagram build",
    "build:manifest": "cem analyze --globs \"src/element/**/*.ts\" --exclude \"src/element/**/*.test.ts\" --outdir .",
    "build:viewer-script": "node scripts/build-viewer-script.mjs",
    "dev": "tsdown --watch",
    "docs:images": "pnpm run build && node scripts/generate-doc-images.mjs",
    "examples": "vitest run tests/visual-outputs.test.ts",
    "gallery:images": "pnpm run build && node scripts/generate-gallery-images.mjs",
    "lint": "eslint .",
    "lint:ox": "oxlint",
    "og:image": "pnpm run build && node scripts/generate-og-image.mjs",
    "prepublishOnly": "pnpm run build && pnpm run validate",
    "release": "npm publish",
    "sync:action": "bash scripts/sync-action-mirror.sh",
    "test": "pnpm run test:viewer-script && vitest run --project unit && vitest run --project element && vitest run --project perf",
    "test:perf": "vitest run --project perf",
    "test:coverage": "vitest run --project unit --coverage",
    "test:viewer-script": "node scripts/build-viewer-script.mjs --check",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run validate:publint && pnpm run validate:types",
    "validate:publint": "publint",
    "validate:types": "attw --pack .",
    "prepare": "husky"
  },
  "keywords": [
    "aws",
    "step-functions",
    "stepfunctions",
    "amazon-states-language",
    "diagram",
    "diagrams-as-code",
    "visualization",
    "visualizer",
    "svg",
    "mermaid",
    "png",
    "html",
    "asl",
    "state-machine",
    "cloudformation",
    "cdk",
    "aws-cdk",
    "sam",
    "cli",
    "typescript",
    "serverless",
    "github-action"
  ],
  "author": "Yusuf Afzal",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@aws-sdk/client-sfn": "^3.879.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^9.34.0",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "node-html-to-image": "^6.2.0",
    "oxlint": "^1.69.0",
    "prettier": "3.6.2",
    "publint": "^0.3.16",
    "puppeteer": "25.3.0",
    "tsdown": "^0.21.7",
    "tsx": "^4.20.5",
    "turbo": "^2.10.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@dagrejs/dagre": "^2.0.0",
    "d3-shape": "^3.2.0",
    "minimatch": "^10.0.1",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-sfn": "^3.0.0",
    "node-html-to-image": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sfn": {
      "optional": true
    },
    "node-html-to-image": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "@humanfs/node": ">=0.16.8",
      "basic-ftp": ">=5.3.1",
      "brace-expansion": ">=5.0.9",
      "browserslist": ">=4.28.7",
      "defu": ">=6.1.5",
      "dompurify": ">=3.4.13",
      "esbuild": ">=0.28.1",
      "fast-uri": ">=3.1.6 <4.0.0",
      "fast-xml-builder": ">=1.1.7",
      "fast-xml-parser": ">=5.7.0",
      "flatted": ">=3.4.2",
      "handlebars": ">=4.7.9",
      "ip-address": ">=10.1.1",
      "js-yaml": ">=4.3.1 <5.0.0",
      "linkify-it": ">=5.0.2 <6.0.0",
      "lodash-es": ">=4.18.0",
      "minimatch": ">=9.0.7",
      "nanoid": ">=3.3.17 <4.0.0",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.18 <9.0.0",
      "qs": ">=6.16.0",
      "rollup": ">=4.59.0",
      "undici": ">=7.29.0 <8.0.0",
      "vite": ">=8.0.16",
      "ws": ">=8.20.1"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufaf/sfn-diagram.git"
  },
  "bugs": {
    "url": "https://github.com/yusufaf/sfn-diagram/issues"
  },
  "homepage": "https://sfn.yusufaf.dev"
}
