{
    "compilerOptions": {
        "esModuleInterop": true,
        "lib": ["ES2020"],
        "module": "preserve",
        "moduleResolution": "bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ES2020",
        "types": ["node"]
    },
    "include": ["src"],
    "exclude": ["out"]
}
