{
    "name": "vscode-sfn-diagram",
    "displayName": "Step Functions Diagram",
    "description": "Preview AWS Step Functions ASL definitions as diagrams",
    "version": "0.1.1",
    "publisher": "yusufaf",
    "icon": "media/icon.png",
    "galleryBanner": {
        "color": "#232f3e",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Visualization",
        "Other"
    ],
    "keywords": [
        "step-functions",
        "stepfunctions",
        "asl",
        "diagram",
        "state-machine"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "sfn-diagram.preview",
                "title": "Preview Step Functions Diagram",
                "category": "Step Functions"
            },
            {
                "command": "sfn-diagram.previewExecution",
                "title": "Preview Execution Overlay",
                "category": "Step Functions"
            },
            {
                "command": "sfn-diagram.clearExecution",
                "title": "Clear Execution Overlay",
                "category": "Step Functions"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "sfn-diagram.preview",
                    "when": "resourceExtname == .json || resourceExtname == .asl",
                    "group": "navigation"
                },
                {
                    "command": "sfn-diagram.previewExecution",
                    "when": "resourceExtname == .json || resourceExtname == .asl",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap",
        "dev": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap --watch",
        "typecheck": "tsc --noEmit",
        "package": "vsce package --no-dependencies",
        "publish:openvsx": "ovsx publish"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/vscode": "^1.85.0",
        "@vscode/vsce": "^3.0.0",
        "esbuild": "^0.25.0",
        "ovsx": "^0.10.0",
        "sfn-diagram": "workspace:*",
        "typescript": "^5.9.2"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/yusufaf/sfn-diagram.git",
        "directory": "packages/vscode-sfn-diagram"
    },
    "homepage": "https://github.com/yusufaf/sfn-diagram/tree/main/packages/vscode-sfn-diagram#readme",
    "bugs": {
        "url": "https://github.com/yusufaf/sfn-diagram/issues"
    }
}
