{
    "name": "vscode-sfn-diagram",
    "displayName": "Step Functions Diagram",
    "description": "Preview AWS Step Functions ASL definitions as diagrams",
    "version": "0.2.0",
    "publisher": "yusufaf",
    "icon": "media/icon.png",
    "galleryBanner": {
        "color": "#232f3e",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Visualization",
        "Other"
    ],
    "keywords": [
        "step-functions",
        "stepfunctions",
        "asl",
        "diagram",
        "state-machine"
    ],
    "activationEvents": [
        "onLanguage:json",
        "onLanguage:jsonc",
        "workspaceContains:**/*.asl.json",
        "workspaceContains:**/*.asl"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "sfn-diagram.preview",
                "title": "Preview Step Functions Diagram",
                "category": "Step Functions"
            },
            {
                "command": "sfn-diagram.previewExecution",
                "title": "Preview Execution Overlay",
                "category": "Step Functions"
            },
            {
                "command": "sfn-diagram.clearExecution",
                "title": "Clear Execution Overlay",
                "category": "Step Functions"
            }
        ],
        "configuration": {
            "title": "Step Functions Diagram",
            "properties": {
                "sfnDiagram.autoPreview": {
                    "type": "boolean",
                    "default": false,
                    "description": "Automatically open the diagram preview when a Step Functions definition (.asl.json or .asl) is opened.",
                    "scope": "window"
                },
                "sfnDiagram.collapseContainers": {
                    "type": "boolean",
                    "default": false,
                    "description": "Collapse Parallel and Map containers into a single placeholder node, keeping large state machines readable.",
                    "scope": "window"
                },
                "sfnDiagram.layout": {
                    "type": "string",
                    "default": "TB",
                    "enum": [
                        "TB",
                        "LR",
                        "RL",
                        "BT"
                    ],
                    "enumDescriptions": [
                        "Top to bottom",
                        "Left to right",
                        "Right to left",
                        "Bottom to top"
                    ],
                    "description": "Default layout direction for new previews. The preview toolbar can override this for the current session.",
                    "scope": "window"
                },
                "sfnDiagram.showIcons": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show AWS service icons on Task nodes. Icons are fetched from the jsDelivr CDN, so this requires network access.",
                    "scope": "window"
                },
                "sfnDiagram.theme": {
                    "type": "string",
                    "default": "auto",
                    "enum": [
                        "auto",
                        "dark",
                        "light"
                    ],
                    "enumDescriptions": [
                        "Follow the current VS Code color theme",
                        "AWS dark theme",
                        "AWS light theme"
                    ],
                    "description": "Default color theme for new previews. The preview toolbar can override this for the current session.",
                    "scope": "window"
                }
            }
        },
        "menus": {
            "editor/title": [
                {
                    "command": "sfn-diagram.preview",
                    "when": "resourceFilename =~ /\\.asl\\.json$/i || resourceExtname == .asl || (resourceExtname == .json && sfnDiagram.isAslDocument)",
                    "group": "navigation"
                },
                {
                    "command": "sfn-diagram.previewExecution",
                    "when": "resourceFilename =~ /\\.asl\\.json$/i || resourceExtname == .asl || (resourceExtname == .json && sfnDiagram.isAslDocument)",
                    "group": "navigation"
                }
            ]
        }
    },
    "scripts": {
        "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap",
        "dev": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap --watch",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "package": "vsce package --no-dependencies",
        "publish:openvsx": "ovsx publish"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/vscode": "^1.85.0",
        "@vscode/vsce": "^3.0.0",
        "esbuild": "^0.25.0",
        "ovsx": "^0.10.0",
        "sfn-diagram": "workspace:*",
        "typescript": "^5.9.2",
        "vitest": "^3.2.6"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/yusufaf/sfn-diagram.git",
        "directory": "packages/vscode-sfn-diagram"
    },
    "homepage": "https://github.com/yusufaf/sfn-diagram/tree/main/packages/vscode-sfn-diagram#readme",
    "bugs": {
        "url": "https://github.com/yusufaf/sfn-diagram/issues"
    }
}
