{
    "name": "sfn-diagram-react",
    "version": "0.5.0",
    "description": "React component for AWS Step Functions ASL diagrams",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "pnpm run build && vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "prepublishOnly": "pnpm run build && pnpm run validate",
        "validate": "pnpm run validate:publint && pnpm run validate:types",
        "validate:publint": "publint",
        "validate:types": "attw --pack ."
    },
    "keywords": [
        "aws",
        "step-functions",
        "stepfunctions",
        "react",
        "component",
        "diagram",
        "asl",
        "state-machine",
        "visualization",
        "svg",
        "mermaid",
        "html",
        "typescript"
    ],
    "author": "Yusuf Afzal",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yusufaf/sfn-diagram.git",
        "directory": "packages/sfn-diagram-react"
    },
    "bugs": {
        "url": "https://github.com/yusufaf/sfn-diagram/issues"
    },
    "homepage": "https://sfn.yusufaf.dev/ecosystem/react/",
    "peerDependencies": {
        "react": "^18.0.0 || ^19.0.0",
        "sfn-diagram": "^1.6.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.0.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "jsdom": "^26.0.0",
        "publint": "^0.3.16",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "sfn-diagram": "workspace:*",
        "tsdown": "^0.23.0",
        "typescript": "^5.9.2",
        "vite": "^8.3.0",
        "vitest": "^4.1.11"
    }
}
