{
    "name": "sfn-diagram-react",
    "version": "0.1.0",
    "description": "React component for AWS Step Functions ASL diagrams",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "files": ["dist"],
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "eslint ."
    },
    "keywords": ["aws", "step-functions", "react", "diagram", "asl"],
    "author": "Yusuf Afzal",
    "license": "MIT",
    "peerDependencies": {
        "react": "^18.0.0",
        "sfn-diagram": "workspace:*"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.6.0",
        "@testing-library/react": "^16.0.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "jsdom": "^26.0.0",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "sfn-diagram": "workspace:*",
        "tsdown": "^0.21.7",
        "typescript": "^5.9.2",
        "vite": "^6.3.0",
        "vitest": "^3.2.6"
    }
}
